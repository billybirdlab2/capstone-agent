{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5-5",
  "permissions": {
    "allow": [
      "Bash(python3 .claude/skills/beam-tools/beam_tools.py *)",
      "Bash(python3 .claude/skills/arxiv-digest/arxiv_digest.py *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Edit(memory/**)",
      "Edit(digests/**)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(python3 .claude/skills/code-retriever/retrieve.py *)",
      "Bash(python3 .claude/skills/code-retriever/check_citations.py *)",
      "Bash(.venv/bin/python3 .claude/skills/code-retriever/retrieve.py *)",
      "Bash(.venv/bin/python3 .claude/skills/code-retriever/check_citations.py *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Edit(CLAUDE.md)",
      "Edit(PERMISSIONS.md)",
      "Edit(.claude/**)"
    ],
    "deny": [
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(pip install *)",
      "Bash(git push * main)",
      "Bash(git push --force *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)",
      "Edit(corpus/**)",
      "Edit(index/**)",
      "WebFetch",
      "WebSearch"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}
